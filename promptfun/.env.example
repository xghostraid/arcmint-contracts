# Copy to .env for local dev (never commit .env). Production: set in Fly/Railway/Render UI.

# --- HTTP server ---
HOST=127.0.0.1
PORT=8787
# Public site origin Claude/users hit (drives approval links + /mcp Host check). No trailing slash.
PROMPTFUN_PUBLIC_URL=http://127.0.0.1:8787

# --- Storage ---
PROMPTFUN_DB=./data/promptfun.sqlite

# --- Auth (set a strong secret before any shared deploy) ---
PROMPTFUN_OAUTH_SIGNING_SECRET=dev-only-change-me

# --- Rate limits & TTLs ---
PROMPTFUN_INTENT_TTL_MS=900000
PROMPTFUN_MAX_INTENTS_PER_HOUR=120
PROMPTFUN_PICTURE_TTL_MS=86400000

# --- IPFS / images ---
PROMPTFUN_IPFS_GATEWAY=https://ipfs.io/ipfs
PROMPTFUN_IPFS_IMAGE_PATH=/api/img
# PROMPTFUN_KUBO_API_URL=http://127.0.0.1:5001
# PROMPTFUN_PINATA_JWT=   # pinFileToIPFS JWT (production alternative to Kubo)
# BLOB_READ_WRITE_TOKEN=  # Vercel Blob — cross-instance picture + HTTPS metadata on serverless

# --- Chain gates (keep OFF until deliberate) ---
# PROMPTFUN_ENABLE_LOCALNET=1
# PROMPTFUN_ENABLE_PUMPFUN_MAINNET=1
# PROMPTFUN_ENABLE_EVM_MAINNETS=1
# PROMPTFUN_ENABLE_PUMPFUN_DEVNET=1
# PROMPTFUN_ENABLE_SPONSORED_MAINNET=0   # real SOL from sponsor; keep off without OAuth + funded sponsor wallet

# --- Sponsored testnet launches (optional) ---
# PROMPTFUN_ENABLE_SPONSORED_LAUNCHES=1
# PROMPTFUN_SPONSOR_SECRET_KEY=
# PROMPTFUN_SPONSOR_MAX_LAMPORTS=20000000
# PROMPTFUN_SPONSOR_KILL_SWITCH=0
# PROMPTFUN_SPONSOR_FEE_RECIPIENT=

# --- RPC overrides (optional) ---
# PROMPTFUN_RPC_SOLANA_DEVNET=

# --- Ops / budget (optional) ---
# PROMPTFUN_MONTHLY_BUDGET_USD=300
# PROMPTFUN_OPS_TOKEN=
