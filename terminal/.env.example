# Network: local | devnet | mainnet. Mainnet moves real funds and also needs TERMINAL_ALLOW_MAINNET=1.
TERMINAL_NETWORK=devnet
# TERMINAL_ALLOW_MAINNET=1

# RPC. Public endpoints are rate-limited; use a dedicated one (Helius, Triton, QuickNode) for real use.
# TERMINAL_RPC_URL=https://api.devnet.solana.com
# TERMINAL_WS_URL=

# Hard cap on SOL spent by a single buy, launch or distribution (sum across wallets).
TERMINAL_MAX_SOL_PER_ACTION=5

# Vault auto-lock after N idle minutes (0 = never). Bots need the vault unlocked; see "Keep unlocked" in Settings.
TERMINAL_AUTO_LOCK_MINUTES=30

# Execution defaults
TERMINAL_PRIORITY_MICROLAMPORTS=100000
TERMINAL_JITO_TIP_LAMPORTS=1000000
# TERMINAL_JITO_URL=https://mainnet.block-engine.jito.wtf
# TERMINAL_JUPITER_URL=https://lite-api.jup.ag/swap/v1
# TERMINAL_PUMP_IPFS_URL=https://pump.fun/api/ipfs

# Bots: shared cap on orders per minute across all bots, and the balance below which a bot wallet raises an alert.
# TERMINAL_BOT_MAX_ACTIONS_PER_MINUTE=30
# TERMINAL_LOW_BALANCE_SOL=0.05

# Trade indexing for the dashboard (poll interval, first-track backfill, 0 = no WebSocket nudge).
# TERMINAL_INGEST_POLL_SECONDS=10
# TERMINAL_INGEST_BACKFILL=1000
# TERMINAL_INGEST_WEBSOCKET=1

# Telegram alerts (outbound only). Both must be set; see README "Telegram alerts".
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional reverse proxy (docker compose --profile proxy)
# TERMINAL_DOMAIN=terminal.example.com
# TERMINAL_BASIC_AUTH_USER=admin
# TERMINAL_BASIC_AUTH_HASH=   # output of: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
