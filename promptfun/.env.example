# Copy to .env for local dev (never commit .env). Production: set in Fly/Railway/Render UI.

# --- HTTP server ---
HOST=127.0.0.1
PORT=8787
# Public site origin Claude/users hit (drives approval links + /mcp Host check). No trailing slash.
PROMPTFUN_PUBLIC_URL=http://127.0.0.1:8787

# --- Storage (intents + coin index) ---
# Local / Docker / Render disk (default):
PROMPTFUN_DB=./data/promptfun.sqlite
#
# Vercel MCP (ephemeral disk): use Turso/libSQL OR Vercel Postgres so intents/coins survive redeploys.
# Turso (recommended — SQLite-compatible):
# TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
# TURSO_AUTH_TOKEN=
# Or libSQL aliases:
# LIBSQL_URL=libsql://...
# LIBSQL_AUTH_TOKEN=
#
# Vercel Postgres (auto when Storage → Postgres is linked):
# POSTGRES_URL=postgres://...
# Or explicit:
# PROMPTFUN_POSTGRES_URL=postgres://...
#
# PROMPTFUN_INDEX_TESTNET_DEMOS=1   # store devnet/testnet demo launches in the coin index (local QA only; explore uses mainnet-only)

# --- Auth (set a strong secret before any shared deploy) ---
PROMPTFUN_OAUTH_SIGNING_SECRET=dev-only-change-me

# --- Rate limits & TTLs ---
PROMPTFUN_INTENT_TTL_MS=900000
PROMPTFUN_MAX_INTENTS_PER_HOUR=120
PROMPTFUN_PICTURE_TTL_MS=86400000

# --- IPFS / images ---
PROMPTFUN_IPFS_GATEWAY=https://ipfs.io/ipfs
PROMPTFUN_IPFS_IMAGE_PATH=/api/img
# PROMPTFUN_KUBO_API_URL=http://127.0.0.1:5001
# PROMPTFUN_PINATA_JWT=   # pinFileToIPFS JWT (production alternative to Kubo)
# BLOB_READ_WRITE_TOKEN=  # Vercel Blob (promptfun-mcp): pictures, metadata JSON, panel handoffs, intents/{id}.json, explore rehydration
# PROMPTFUN_BLOB_READ_WRITE_TOKEN=  # optional alias for BLOB_READ_WRITE_TOKEN

# --- Chain gates (keep OFF until deliberate) ---
# PROMPTFUN_ENABLE_LOCALNET=1
# PROMPTFUN_ENABLE_PUMPFUN_MAINNET=1
# PROMPTFUN_ENABLE_EVM_MAINNETS=1   # all EVM mainnets (real funds)
# PROMPTFUN_ENABLE_ROBINHOOD_MAINNET=1   # Robinhood Chain mainnet only (4663; wallet approval, real ETH)
# PROMPTFUN_ENABLE_PUMPFUN_DEVNET=1
# PROMPTFUN_ENABLE_SPONSORED_MAINNET=1   # sponsored pump.fun on Solana mainnet (no wallet); fund sponsor pubkey with mainnet SOL

# --- Sponsored testnet launches (optional) ---
# PROMPTFUN_ENABLE_SPONSORED_LAUNCHES=1
# PROMPTFUN_SPONSOR_SECRET_KEY=   # prod (Vercel): secret for 5YPhpDDtYtKaKnUgSskb4tXKZL9a7rj8siCuMS7qESpv — never commit
# PROMPTFUN_SPONSOR_MAX_LAMPORTS=20000000
# PROMPTFUN_SPONSOR_KILL_SWITCH=0
# PROMPTFUN_SPONSOR_FEE_RECIPIENT=   # prod: 5YPhpDDtYtKaKnUgSskb4tXKZL9a7rj8siCuMS7qESpv (or omit; code default)

# --- RPC overrides (optional) ---
# PROMPTFUN_RPC_SOLANA_DEVNET=
# PROMPTFUN_RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com

# --- Ops / budget (optional) ---
# PROMPTFUN_MONTHLY_BUDGET_USD=300
# PROMPTFUN_OPS_TOKEN=

# Creator fees: holder ≥1 $PROMPT → 100% on-chain; else 50/50. See docs/prompt-fee-tier-spec.md
# PROMPTFUN_PROMPT_MINT=385pCEMj4T1rTp2vgCVxmuUR2zTTmqkV6Yu3U96Fpump  # default when unset; empty or 0 disables tier gate
# PROMPTFUN_PROMPT_MIN_BALANCE=   # optional raw units; default 1 whole token
# PROMPTFUN_TREASURY_PUBKEY=      # prod: same as sponsor pubkey (5YPhp…ESpv); 50% non-holder half post-$PROMPT
